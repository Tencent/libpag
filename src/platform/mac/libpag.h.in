// This file is an umbrella header for libpag on macOS platform. It is configured by CMake so the
// exported backend surface-category header matches the backend the framework was built with —
// framework consumers do not see libpag's TGFX_USE_* build macros, so the selection has to be
// made here at generate time.
#import <libpag/PAG.h>
#import <libpag/PAGComposition.h>
#import <libpag/PAGDiskCache.h>
#import <libpag/PAGFile.h>
#import <libpag/PAGFont.h>
#import <libpag/PAGImage.h>
#import <libpag/PAGImageLayer.h>
#import <libpag/PAGLayer.h>
#import <libpag/PAGMarker.h>
#import <libpag/PAGPlayer.h>
#import <libpag/PAGScaleMode.h>
#import <libpag/PAGShapeLayer.h>
#import <libpag/PAGSolidLayer.h>
#import <libpag/PAGSurface.h>
#import <libpag/@PAG_SURFACE_BACKEND_HEADER@>
#import <libpag/PAGText.h>
#import <libpag/PAGTextLayer.h>
#import <libpag/PAGTimeStretchMode.h>
#import <libpag/PAGVideoDecoder.h>
#import <libpag/PAGVideoRange.h>
#import <libpag/PAGView.h>
