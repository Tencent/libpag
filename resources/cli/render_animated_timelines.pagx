<?xml version="1.0" encoding="UTF-8"?>
<!-- Animated render through both activation scopes: a top-level animation switches the left box
     from blue to yellow at frame 10, and a Composition timeline switches the slot boxes from green to
     red at frame 10. The middle slot mounts the timeline with evaluationOffset="5" (switch at frame
     15), and the right slot mounts it paused, so it stays green. -->
<pagx width="300" height="100">
  <Resources>
    <Composition id="card" width="60" height="60">
      <Layer width="60" height="60">
        <Rectangle position="30,30" size="60,60"/>
        <Fill>
          <SolidColor id="cardColor" color="#00FF00"/>
        </Fill>
      </Layer>
      <Animations>
        <Animation id="cardShift" duration="20" frameRate="60" loop="once">
          <Object target="cardColor">
            <Channel name="color" type="color">
              <Key time="0" value="#00FF00" interpolation="hold"/>
              <Key time="10" value="#FF0000" interpolation="hold"/>
            </Channel>
          </Object>
        </Animation>
      </Animations>
    </Composition>
  </Resources>
  <Layer x="20" y="20" width="60" height="60">
    <Rectangle position="30,30" size="60,60"/>
    <Fill>
      <SolidColor id="topColor" color="#0000FF"/>
    </Fill>
  </Layer>
  <Layer x="120" y="20" width="60" height="60" composition="@card">
    <Timelines>
      <Animation ref="@cardShift" evaluationOffset="5"/>
    </Timelines>
  </Layer>
  <Layer x="220" y="20" width="60" height="60" composition="@card">
    <Timelines>
      <Animation ref="@cardShift" playing="false"/>
    </Timelines>
  </Layer>
  <Animations>
    <Animation id="topShift" duration="20" frameRate="60" loop="once">
      <Object target="topColor">
        <Channel name="color" type="color">
          <Key time="0" value="#0000FF" interpolation="hold"/>
          <Key time="10" value="#FFFF00" interpolation="hold"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
