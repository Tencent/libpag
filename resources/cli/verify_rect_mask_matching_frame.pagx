<?xml version="1.0" encoding="UTF-8"?>
<!-- Test: the rectangular mask covers exactly the layer frame, so clipToBounds is equivalent -->
<pagx width="200" height="100">
  <Layer id="maskLayer" visible="false">
    <Rectangle position="50,25" size="100,50"/>
    <Fill color="#FFFFFF"/>
  </Layer>
  <Layer left="0" top="0" width="100" height="50" mask="@maskLayer" maskType="alpha">
    <Rectangle position="100,50" size="200,100"/>
    <Fill color="#FF0000"/>
  </Layer>
</pagx>
