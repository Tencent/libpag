<?xml version="1.0" encoding="UTF-8"?>
<!-- Regression resource for shadow spread on both PAGX shadow style types. -->
<pagx width="320" height="200">
  <Layer id="outerLayer" left="40" top="40" width="120" height="80">
    <Rectangle width="120" height="80" roundness="16"/>
    <Fill color="#E6E6E6"/>
    <DropShadowStyle id="drop" offsetY="8" blurX="6" blurY="6" spread="8" color="#00000080"/>
  </Layer>
  <Layer id="innerLayer" left="180" top="40" width="100" height="80">
    <Ellipse width="100" height="80"/>
    <Fill color="#4A90D9"/>
    <InnerShadowStyle id="inner" offsetY="6" blurX="5" blurY="5" spread="-6" color="#282828"/>
  </Layer>
  <Animations>
    <Animation id="spread-animation" duration="120" frameRate="60" loop="once">
      <Object target="inner">
        <Channel name="spread" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="30" value="8" interpolation="linear"/>
          <Key time="60" value="-8" interpolation="linear"/>
          <Key time="90" value="0"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
