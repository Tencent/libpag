<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: An Ellipse position.x moves the oval along its layer without changing its size.
     Target: Ellipse  Channel: position.x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse id="slideEllipseX" position="110,100" size="110,120"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="slideEllipseX">
        <Channel name="position.x" type="float">
          <Key time="0" value="110" interpolation="linear"/>
          <Key time="60" value="230"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
