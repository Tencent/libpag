<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Polystar position.x slides the whole star horizontally.
     Target: Polystar  Channel: position.x  Type: float
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar id="starSlideX" position="100,100" type="polygon" pointCount="6" outerRadius="70"
              rotation="-90"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="starSlideX">
        <Channel name="position.x" type="float">
          <Key time="0" value="100" interpolation="linear"/>
          <Key time="60" value="220"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
