<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Polystar innerRadius widens the star's waist until the spikes almost disappear.
     Target: Polystar  Channel: innerRadius  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar id="starInner" position="160,100" type="star" pointCount="5" outerRadius="85"
              innerRadius="20" rotation="-90"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="starInner">
        <Channel name="innerRadius" type="float">
          <Key time="0" value="20" interpolation="linear"/>
          <Key time="60" value="80"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
