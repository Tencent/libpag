<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Rectangle roundness turns sharp corners into fully rounded ones.
     Target: Rectangle  Channel: roundness  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle id="roundRect" position="160,100" size="200,120" roundness="0"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="rectRoundGrow" duration="60" frameRate="60" loop="once">
      <Object target="roundRect">
        <Channel name="roundness" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="60" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
