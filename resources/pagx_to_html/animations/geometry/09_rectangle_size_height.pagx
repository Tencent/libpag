<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Rectangle size.height collapses the box vertically around its centre.
     Target: Rectangle  Channel: size.height  Type: float
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle id="shrinkRectH" position="160,100" size="200,150" roundness="10"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="shrinkRectH">
        <Channel name="size.height" type="float">
          <Key time="0" value="150" interpolation="linear"/>
          <Key time="60" value="40"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
