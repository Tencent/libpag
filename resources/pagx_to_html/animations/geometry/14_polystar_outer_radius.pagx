<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Polystar outerRadius grows every spike away from the same centre.
     Target: Polystar  Channel: outerRadius  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar id="starOuter" position="160,100" type="star" pointCount="6" outerRadius="50"
              innerRadius="24" rotation="-90"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="starOuter">
        <Channel name="outerRadius" type="float">
          <Key time="0" value="50" interpolation="linear"/>
          <Key time="60" value="88"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
