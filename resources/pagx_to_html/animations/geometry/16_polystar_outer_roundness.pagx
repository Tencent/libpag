<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Polystar outerRoundness turns the sharp spike tips into rounded caps.
     Target: Polystar  Channel: outerRoundness  Type: float
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar id="starOuterRound" position="160,100" type="star" pointCount="5" outerRadius="85"
              innerRadius="30" rotation="-90"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="starOuterRound">
        <Channel name="outerRoundness" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="1"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
