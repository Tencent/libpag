<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A TrimPath offset slides the visible dash along a partial trim without changing its length.
     Target: TrimPath  Channel: offset  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse position="160,100" size="230,140"/>
    <TrimPath id="trimOffset" start="0" end="0.35" offset="0" type="separate"/>
    <Stroke color="#B45309" width="16" cap="round"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="trimOffset">
        <Channel name="offset" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="180"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
