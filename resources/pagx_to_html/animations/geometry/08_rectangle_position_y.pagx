<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Rectangle position.y lifts the box towards the top edge of its layer.
     Target: Rectangle  Channel: position.y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle id="slideRectY" position="160,130" size="90,100" roundness="10"/>
    <Fill color="#B45309"/>
  </Layer>
  <Animations>
    <Animation id="geoAnim" duration="60" frameRate="60" loop="once">
      <Object target="slideRectY">
        <Channel name="position.y" type="float">
          <Key time="0" value="130" interpolation="linear"/>
          <Key time="60" value="50"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
