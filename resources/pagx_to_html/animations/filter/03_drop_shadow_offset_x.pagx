<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: DropShadowFilter offsetX moves a hard shadow from behind the box to the right.
     Target: DropShadowFilter  Channel: offsetX  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer x="60" y="60" width="100" height="80">
    <Rectangle position="50,40" size="100,80" roundness="8"/>
    <Fill color="#2563EB"/>
    <DropShadowFilter id="shadowOffsetX" offsetX="0" offsetY="0" blurX="0" blurY="0" color="#1E3A8A"/>
  </Layer>
  <Animations>
    <Animation id="shadowSlideX" duration="60" frameRate="60" loop="once">
      <Object target="shadowOffsetX">
        <Channel name="offsetX" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="80" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
