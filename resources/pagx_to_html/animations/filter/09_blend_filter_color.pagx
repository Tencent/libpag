<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: BlendFilter color tints the card from its own green towards yellow with a multiply blend.
     Target: BlendFilter  Channel: color  Type: color
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar type="polygon" pointCount="6" outerRadius="46" position="90,100"/>
    <Fill color="#15803D"/>
    <BlendFilter id="blendTintFilter" color="#15803D" blendMode="multiply"/>
  </Layer>
  <Animations>
    <Animation id="blendTint" duration="60" frameRate="60" loop="once">
      <Object target="blendTintFilter">
        <Channel name="color" type="color">
          <Key time="0" value="#15803D" interpolation="linear"/>
          <Key time="60" value="#FDE047"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
