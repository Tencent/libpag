<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: NoiseFilter density turns the card from clean into fully grained.
     Target: Layer  Channel: density  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar type="polygon" pointCount="6" outerRadius="46" position="90,100"/>
    <Fill color="#15803D"/>
    <NoiseFilter id="grainFilter" mode="mono" size="4" density="0" color="#0F172A"/>
  </Layer>
  <Animations>
    <Animation id="grainRamp" duration="60" frameRate="60" loop="once">
      <Object target="grainFilter">
        <Channel name="density" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="1"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
