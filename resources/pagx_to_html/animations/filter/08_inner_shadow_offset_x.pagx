<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: InnerShadowFilter offsetX moves the inner shadow from the top edge towards the right edge.
     Target: InnerShadowFilter  Channel: offsetX  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar type="polygon" pointCount="6" outerRadius="46" position="90,100"/>
    <Fill color="#15803D"/>
    <InnerShadowFilter id="innerShadowFilter" offsetX="0" offsetY="6" blurX="10" blurY="10" color="#052E16"/>
  </Layer>
  <Animations>
    <Animation id="innerShadowSlide" duration="60" frameRate="60" loop="once">
      <Object target="innerShadowFilter">
        <Channel name="offsetX" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="30"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
