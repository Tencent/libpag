<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: NoiseFilter seed changes the random pattern, so every grain cell moves at the switch instead of
     interpolating.
     Target: NoiseFilter  Channel: seed  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse position="90,90" size="120,120"/>
    <Fill color="#BFDBFE"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse position="230,120" size="110,110"/>
    <Fill color="#FBCFE8"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="190,130" roundness="18"/>
    <Fill color="#FFFFFF"/>
    <NoiseFilter id="grain" mode="mono" size="6" density="0.8" seed="1"
                 color="#1E1B4B"/>
  </Layer>
  <Animations>
    <Animation id="noiseAnim" duration="60" frameRate="60" loop="once">
      <Object target="grain">
        <Channel name="seed" type="float">
          <Key time="0" value="1" interpolation="hold"/>
          <Key time="30" value="7" interpolation="hold"/>
          <Key time="60" value="7"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
