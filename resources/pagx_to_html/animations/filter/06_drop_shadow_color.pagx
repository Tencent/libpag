<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: DropShadowFilter color animates the hard shadow from deep blue to orange.
     Target: DropShadowFilter  Channel: color  Type: color
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer x="60" y="40" width="120" height="80">
    <Rectangle position="60,40" size="120,80" roundness="8"/>
    <Fill color="#2563EB"/>
    <DropShadowFilter id="shadowColor" offsetX="60" offsetY="40" blurX="0" blurY="0" color="#1E3A8A"/>
  </Layer>
  <Animations>
    <Animation id="shadowColorShift" duration="60" frameRate="60" loop="once">
      <Object target="shadowColor">
        <Channel name="color" type="color">
          <Key time="0" value="#1E3A8A" interpolation="linear"/>
          <Key time="60" value="#F97316" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
