<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A TextModifier strokeWidth thickens the glyph outline until the fill is almost covered.
     Target: TextModifier  Channel: strokeWidth  Type: float
     Expect: supported
     Known-gap: modifier-stroke-width（按因子从静态宽度插值，0.981）
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="WAVE" fontFamily="Arial" fontStyle="Bold" fontSize="64" letterSpacing="0"
          position="50,130"/>
    <TextModifier id="modifier">
      <RangeSelector start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
    <Stroke color="#1E1B4B" width="1"/>
  </Layer>
  <Animations>
    <Animation id="modifierAnim" duration="60" frameRate="60" loop="once">
      <Object target="modifier">
        <Channel name="strokeWidth" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="6"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>