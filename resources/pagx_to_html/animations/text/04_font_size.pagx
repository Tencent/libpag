<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A font size channel scales the glyphs up from a small size, so the exported keyframes have to drive a
     length that CSS cannot take from the same property as the static style.
     Target: Text  Channel: fontSize  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text id="growText" text="Ag" fontFamily="Arial" fontStyle="Bold" fontSize="24" position="40,120"/>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="fontGrow" duration="60" frameRate="60" loop="once">
      <Object target="growText">
        <Channel name="fontSize" type="float">
          <Key time="0" value="24" interpolation="linear"/>
          <Key time="60" value="96"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
