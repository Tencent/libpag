<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: TextModifier fillColor overrides the shared fill so the glyphs re-tint without touching the layer fill.
     Target: TextModifier  Channel: fillColor  Type: color
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="AB" fontFamily="Arial" fontStyle="Bold" fontSize="72" position="90,120"/>
    <TextModifier id="tintModifier" fillColor="#BE123C">
      <RangeSelector start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="glyphTint" duration="60" frameRate="60" loop="once">
      <Object target="tintModifier">
        <Channel name="fillColor" type="color">
          <Key time="0" value="#BE123C" interpolation="linear"/>
          <Key time="60" value="#F59E0B"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
