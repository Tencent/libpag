<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A string channel replaces the glyph content itself, which CSS cannot express without swapping nodes.
     Target: Text  Channel: text  Type: string
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text id="glyphText" text="AB" fontFamily="Arial" fontStyle="Bold" fontSize="72" position="80,120"/>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="glyphSwap" duration="60" frameRate="60" loop="once">
      <Object target="glyphText">
        <Channel name="text" type="string">
          <Key time="0" value="AB" interpolation="hold"/>
          <Key time="30" value="MOVE" interpolation="hold"/>
          <Key time="60" value="MOVE"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
