<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Text x channel slides the layout anchor, taking the whole word with it.
     Target: Text  Channel: x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text id="word" text="Ag" fontFamily="Arial" fontStyle="Regular" fontSize="80"
          letterSpacing="0" position="60,60"/>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="textAnim" duration="60" frameRate="60" loop="once">
      <Object target="word">
        <Channel name="x" type="float">
          <Key time="0" value="60" interpolation="linear"/>
          <Key time="60" value="170"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
