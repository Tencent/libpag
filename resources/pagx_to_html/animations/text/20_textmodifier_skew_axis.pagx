<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A TextModifier skewAxis rotates the shear direction while the shear angle stays fixed.
     Target: TextModifier  Channel: skewAxis  Type: float
     modifier-skew-axis-calibration：0.812，skewAxis 与 skew 的组合顺序待与运行时对齐
     Known-gap: skew-axis-residual（轴方向已修正，0.812→0.907；剩余差疑为轴角语义仍与运行时不同）
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="WAVE" fontFamily="Arial" fontStyle="Bold" fontSize="64" letterSpacing="0"
          position="50,130"/>
    <TextModifier id="modifier" skew="24">
      <RangeSelector start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="modifierAnim" duration="60" frameRate="60" loop="once">
      <Object target="modifier">
        <Channel name="skewAxis" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="70"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
