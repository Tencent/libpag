<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A TextModifier strokeColor re-tints the glyph outline without touching the fill.
     Target: TextModifier  Channel: strokeColor  Type: color
     Known-gap: modifier-stroke-color（按字形因子从底色插值，0.971；剩余为文本基线差）
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="WAVE" fontFamily="Arial" fontStyle="Bold" fontSize="64" letterSpacing="0"
          position="50,130"/>
    <TextModifier id="modifier">
      <RangeSelector start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
    <Stroke color="#1E1B4B" width="3"/>
  </Layer>
  <Animations>
    <Animation id="modifierAnim" duration="60" frameRate="60" loop="once">
      <Object target="modifier">
        <Channel name="strokeColor" type="color">
          <Key time="0" value="#1E1B4B" interpolation="linear"/>
          <Key time="60" value="#F59E0B"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>