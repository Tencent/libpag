<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A TextModifier anchor.y slides the per-glyph pivot down the glyph box.
     Target: TextModifier  Channel: anchor.y  Type: float
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="WAVE" fontFamily="Arial" fontStyle="Bold" fontSize="64" letterSpacing="0"
          position="50,130"/>
    <TextModifier id="modifier" rotation="18">
      <RangeSelector start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="modifierAnim" duration="60" frameRate="60" loop="once">
      <Object target="modifier">
        <Channel name="anchor.y" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="140"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
