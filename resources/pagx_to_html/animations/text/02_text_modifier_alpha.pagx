<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: TextModifier alpha fades only the glyphs driven by the selector.
     Target: TextModifier  Channel: alpha  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="AB" fontFamily="Arial" fontStyle="Bold" fontSize="72" position="90,120"/>
    <TextModifier id="fadeModifier" alpha="1">
      <RangeSelector start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="glyphFade" duration="60" frameRate="60" loop="once">
      <Object target="fadeModifier">
        <Channel name="alpha" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="0.1"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
