<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a frameRate of 30 makes the 60 frame duration span two seconds of playback.
     Target: Layer  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="slowBox" x="120" y="60" width="80" height="80">
    <Ellipse position="40,40" size="80,80"/>
    <Fill color="#0284C7"/>
  </Layer>
  <Animations>
    <Animation id="slowFade" duration="60" frameRate="30" loop="once">
      <Object target="slowBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="0.2" interpolation="linear"/>
          <Key time="60" value="1" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
