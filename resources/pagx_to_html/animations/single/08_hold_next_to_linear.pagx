<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="box" left="40" top="70" width="80" height="60">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="mix" duration="60" frameRate="60" loop="once">
      <Object target="box">
        <Channel name="alpha" type="float">
          <Key time="0" value="0" interpolation="hold"/>
          <Key time="30" value="1" interpolation="linear"/>
          <Key time="60" value="0"/>
        </Channel>
        <Channel name="x" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="100"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
