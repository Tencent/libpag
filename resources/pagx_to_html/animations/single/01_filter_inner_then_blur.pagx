<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A filter chain whose residual stage (inner shadow) sits BEFORE the animatable one (blur).
     Target: BlurFilter  Channel: blurX, blurY  Type: float
     Chain order must survive: the reference is inner-shadow-then-blur, so the blur has to run on the
     already-shadowed image. Emitting one residual wrapper outside the animated list turns it into
     blur-then-inner-shadow.
     Ref: R17 -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="140,100" roundness="12"/>
    <Fill color="#1D4ED8"/>
    <InnerShadowFilter id="inner" offsetX="0" offsetY="6" blurX="8" blurY="8" color="#0F172A"/>
    <BlurFilter id="blur" blurX="0" blurY="0"/>
  </Layer>
  <Animations>
    <Animation id="chain" duration="60" frameRate="60" loop="once">
      <Object target="blur">
        <Channel name="blurX" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="10"/>
        </Channel>
        <Channel name="blurY" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="10"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
