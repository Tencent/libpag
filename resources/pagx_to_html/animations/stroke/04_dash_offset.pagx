<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Stroke dashOffset shifts a static dash pattern by half a dash period.
     Target: Stroke  Channel: dashOffset  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="160,120" roundness="16"/>
    <Fill color="#FFFFFF"/>
    <Stroke id="dashStroke" color="#2563EB" width="8" dashes="12,8" dashOffset="0"/>
  </Layer>
  <Animations>
    <Animation id="strokeDashShift" duration="60" frameRate="60" loop="once">
      <Object target="dashStroke">
        <Channel name="dashOffset" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="10" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
