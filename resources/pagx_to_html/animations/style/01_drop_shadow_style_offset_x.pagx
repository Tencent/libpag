<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: DropShadowStyle offsetX slides the card shadow from under the card to its right side.
     Target: DropShadowStyle  Channel: offsetX  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="150,90" size="150,110" roundness="16"/>
    <Fill color="#FFFFFF"/>
    <DropShadowStyle id="cardShadow" offsetX="0" offsetY="14" blurX="10" blurY="10" color="#1E1B4B80"/>
  </Layer>
  <Animations>
    <Animation id="shadowSlide" duration="60" frameRate="60" loop="once">
      <Object target="cardShadow">
        <Channel name="offsetX" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="40"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
