<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: BackgroundBlurStyle blurY smears the backdrop vertically behind the translucent card, leaving its
     horizontal detail intact.
     Target: BackgroundBlurStyle  Channel: blurY  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar position="100,80" type="star" pointCount="5" outerRadius="62" innerRadius="26"
              rotation="-90"/>
    <Fill color="#4338CA"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse position="225,125" size="120,120"/>
    <Fill color="#0EA5E9"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="170,120" roundness="16"/>
    <Fill color="#FFFFFF66"/>
    <BackgroundBlurStyle id="styleNode" blurX="0"/>
  </Layer>
  <Animations>
    <Animation id="styleAnim" duration="60" frameRate="60" loop="once">
      <Object target="styleNode">
        <Channel name="blurY" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="26"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
