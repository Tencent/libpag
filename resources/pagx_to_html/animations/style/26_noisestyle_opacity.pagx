<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: NoiseStyle opacity fades the multi-colour grain from invisible to fully applied.
     Target: NoiseStyle  Channel: opacity  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="170,120" roundness="16"/>
    <Fill color="#FFFFFF"/>
    <NoiseStyle id="styleNode" mode="multi" size="6" density="0.85" seed="1" color="#1E1B4B"/>
  </Layer>
  <Animations>
    <Animation id="styleAnim" duration="60" frameRate="60" loop="once">
      <Object target="styleNode">
        <Channel name="opacity" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="1"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
