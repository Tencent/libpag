<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: GlassStyle lightIntensity brightens the rim highlight from a faint edge into a strong glint.
     Target: GlassStyle  Channel: lightIntensity  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Polystar position="100,80" type="star" pointCount="5" outerRadius="62" innerRadius="26"
              rotation="-90"/>
    <Fill color="#4338CA"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse position="225,125" size="120,120"/>
    <Fill color="#0EA5E9"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="170,120" roundness="16"/>
    <Fill color="#FFFFFF33"/>
    <GlassStyle id="styleNode" refraction="95" depth="55" frost="0" dispersion="0" splay="0" lightAngle="45" lightIntensity="60"/>
  </Layer>
  <Animations>
    <Animation id="styleAnim" duration="60" frameRate="60" loop="once">
      <Object target="styleNode">
        <Channel name="lightIntensity" type="float">
          <Key time="0" value="10" interpolation="linear"/>
          <Key time="60" value="100"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
