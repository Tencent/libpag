<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: DropShadowStyle showBehindLayer puts the shadow behind the translucent card instead of painting
     it over the card, switching at the middle of the timeline.
     Target: DropShadowStyle  Channel: showBehindLayer  Type: bool
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="170,120" roundness="16"/>
    <Fill color="#FFFFFFB3"/>
    <DropShadowStyle id="styleNode" offsetX="0" offsetY="18" blurX="12" blurY="12" color="#1E1B4B" showBehindLayer="false"/>
  </Layer>
  <Animations>
    <Animation id="styleAnim" duration="60" frameRate="60" loop="once">
      <Object target="styleNode">
        <Channel name="showBehindLayer" type="bool">
          <Key time="0" value="false" interpolation="hold"/>
          <Key time="30" value="true" interpolation="hold"/>
          <Key time="60" value="true"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
