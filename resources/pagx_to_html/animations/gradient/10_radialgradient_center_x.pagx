<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: RadialGradient center.x walks the bright core from the middle of the card to its left edge.
     Target: RadialGradient  Channel: center.x  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="160,100" size="220,150" roundness="18"/>
    <Fill>
      <RadialGradient id="grad" center="0.5,0.5" radius="0.35">
        <ColorStop offset="0" color="#FDE047"/>
        <ColorStop offset="1" color="#0891B2"/>
      </RadialGradient>    </Fill>
  </Layer>
  <Animations>
    <Animation id="gradAnim" duration="60" frameRate="60" loop="once">
      <Object target="grad">
        <Channel name="center.x" type="float">
          <Key time="0" value="0.5" interpolation="linear"/>
          <Key time="60" value="0.15"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
