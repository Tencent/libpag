<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: RadialGradient radius grows the color core from the card center outwards.
     Target: RadialGradient  Channel: radius  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Ellipse position="160,100" size="180,150"/>
    <Fill>
      <RadialGradient id="radialGrowGrad" center="0.5,0.5" radius="0.2">
        <ColorStop offset="0" color="#0891B2"/>
        <ColorStop offset="1" color="#F59E0B"/>
      </RadialGradient>    </Fill>
  </Layer>
  <Animations>
    <Animation id="coreGrow" duration="60" frameRate="60" loop="once">
      <Object target="radialGrowGrad">
        <Channel name="radius" type="float">
          <Key time="0" value="0.2" interpolation="linear"/>
          <Key time="60" value="0.8"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
