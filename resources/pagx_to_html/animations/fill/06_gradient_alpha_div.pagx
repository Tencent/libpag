<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Fill alpha fades a gradient-painted CSS box between fully opaque and 0.1. The box paints
     the gradient as its background, so the keyframe must fade that background instead of adding an
     opaque black background-color underneath it, which leaves the box frozen at its static alpha.
     The small swatch in the bottom-right corner is an unanimated copy of the same gradient, so a
     frozen box is visible at a glance.
     Target: Fill  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="100,100" size="160,160" roundness="12"/>
    <Fill id="gradBoxFill" alpha="1">
      <LinearGradient startPoint="20,20" endPoint="180,180">
        <ColorStop offset="0" color="#1E3A8A"/>
        <ColorStop offset="1" color="#FDE047"/>
      </LinearGradient>
    </Fill>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="282,166" size="44,44" roundness="6"/>
    <Fill id="gradBoxRef">
      <LinearGradient startPoint="260,144" endPoint="304,188">
        <ColorStop offset="0" color="#1E3A8A"/>
        <ColorStop offset="1" color="#FDE047"/>
      </LinearGradient>
    </Fill>
  </Layer>
  <Animations>
    <Animation id="gradientBoxFade" duration="120" frameRate="60" loop="loop">
      <Object target="gradBoxFill">
        <Channel name="alpha" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="0.1" interpolation="linear"/>
          <Key time="120" value="1"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
