<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Fill alpha fades text glyphs from 0.2 to fully opaque.
     Target: Fill  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="AB" fontFamily="Arial" fontSize="32" position="120,80"/>
    <Fill id="textFill" color="#1D4ED8" alpha="1"/>
  </Layer>
  <Animations>
    <Animation id="textFillFade" duration="60" frameRate="60" loop="once">
      <Object target="textFill">
        <Channel name="alpha" type="float">
          <Key time="0" value="0.2" interpolation="linear"/>
          <Key time="60" value="1" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
