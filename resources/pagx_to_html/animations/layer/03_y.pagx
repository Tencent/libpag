<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Layer y slides a box down the canvas while x stays fixed.
     Target: Layer  Channel: y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="dropBox" x="120" y="20" width="80" height="80">
    <Rectangle position="40,40" size="80,80" roundness="8"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="dropY" duration="60" frameRate="60" loop="once">
      <Object target="dropBox">
        <Channel name="y" type="float">
          <Key time="0" value="20" interpolation="linear"/>
          <Key time="60" value="120" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
