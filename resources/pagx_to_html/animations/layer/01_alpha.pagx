<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Layer alpha fades a single box from 0.2 to fully opaque over the full duration. This is the
     canonical baseline for the alpha channel and also the reference for linear interpolation with
     loop="once", so the interpolation and timing families do not repeat it.
     Target: Layer  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="fadeBox" x="120" y="60" width="80" height="80">
    <Polystar type="polygon" pointCount="4" outerRadius="44" position="40,40"/>
    <Fill color="#4F46E5"/>
  </Layer>
  <Animations>
    <Animation id="fade" duration="60" frameRate="60" loop="once">
      <Object target="fadeBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="0.2" interpolation="linear"/>
          <Key time="60" value="1" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
