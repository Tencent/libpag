<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a blendMode channel switches a red layer from normal to multiply over a blue backdrop.
     Target: Layer  Channel: blendMode  Type: int
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer x="80" y="40" width="160" height="120">
    <Rectangle position="80,60" size="160,120"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Layer id="blendBox" x="100" y="60" width="120" height="80">
    <Rectangle position="60,40" size="120,80"/>
    <Fill color="#F97316"/>
  </Layer>
  <Animations>
    <Animation id="blendSwitch" duration="60" frameRate="60" loop="once">
      <Object target="blendBox">
        <Channel name="blendMode" type="int">
          <Key time="0" value="0" interpolation="hold"/>
          <Key time="30" value="1" interpolation="hold"/>
          <Key time="60" value="1" interpolation="hold"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
