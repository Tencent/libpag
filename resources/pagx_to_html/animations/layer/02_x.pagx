<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Layer x slides a box across the canvas while y stays fixed.
     Target: Layer  Channel: x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="slideBox" x="40" y="60" width="80" height="80">
    <Rectangle position="40,40" size="80,80" roundness="8"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="slideX" duration="60" frameRate="60" loop="once">
      <Object target="slideBox">
        <Channel name="x" type="float">
          <Key time="0" value="40" interpolation="linear"/>
          <Key time="60" value="240" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
