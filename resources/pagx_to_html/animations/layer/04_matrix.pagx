<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Layer matrix scales the layer content from identity to twice its size. A matrix channel
     replaces the layer's x/y translation, so each key carries the translate that keeps the box on
     the canvas.
     Target: Layer  Channel: matrix  Type: matrix
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="scaleBox" x="100" y="20" width="80" height="80">
    <Polystar type="polygon" pointCount="4" outerRadius="44" position="40,40"/>
    <Fill color="#4F46E5"/>
  </Layer>
  <Animations>
    <Animation id="scaleUp" duration="60" frameRate="60" loop="once">
      <Object target="scaleBox">
        <Channel name="matrix" type="matrix">
          <Key time="0" value="1,0,0,1,100,20" interpolation="linear"/>
          <Key time="60" value="2,0,0,2,100,20" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
