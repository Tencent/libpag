<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Layer rotation.y turns the box around its vertical axis, so perspective foreshortens it.
     Target: Layer  Channel: rotation.y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="spinBoxY" x="120" y="60" width="80" height="80" perspective="500">
    <Path data="M 8,12 L 72,34 L 24,72 Z"/>
    <Fill color="#4F46E5"/>
  </Layer>
  <Animations>
    <Animation id="spinY" duration="60" frameRate="60" loop="once">
      <Object target="spinBoxY">
        <Channel name="rotation.y" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="60"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
