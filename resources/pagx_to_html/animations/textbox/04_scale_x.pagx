<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: TextBox scale.x stretches the laid out text horizontally.
     Target: TextBox  Channel: scale.x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <TextBox id="scaleTextBox" left="40" top="80" width="140" height="48" scale="1,1">
      <Text text="AB" fontFamily="Arial" fontSize="32"/>
      <Fill color="#1D4ED8"/>
    </TextBox>
  </Layer>
  <Animations>
    <Animation id="textBoxStretchX" duration="60" frameRate="60" loop="once">
      <Object target="scaleTextBox">
        <Channel name="scale.x" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="2" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
