<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: TextBox anchor.x moves the pivot of a statically rotated text block.
     Target: TextBox  Channel: anchor.x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <TextBox id="boxAnchorX" position="40,50" width="220" height="90" textAlign="center" paragraphAlign="middle" rotation="20">
      <Text text="AB" fontFamily="Arial" fontSize="36"/>
      <Fill color="#7C3AED"/>
    </TextBox>
  </Layer>
  <Animations>
    <Animation id="boxPivotX" duration="60" frameRate="60" loop="once">
      <Object target="boxAnchorX">
        <Channel name="anchor.x" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="60"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
