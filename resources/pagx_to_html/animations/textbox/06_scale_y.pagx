<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: TextBox scale.y stretches the laid out text block vertically.
     Target: TextBox  Channel: scale.y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <TextBox id="boxScaleY" position="40,50" width="220" height="90" textAlign="center" paragraphAlign="middle">
      <Text text="AB" fontFamily="Arial" fontSize="36"/>
      <Fill color="#7C3AED"/>
    </TextBox>
  </Layer>
  <Animations>
    <Animation id="boxStretchY" duration="60" frameRate="60" loop="once">
      <Object target="boxScaleY">
        <Channel name="scale.y" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="1.6"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
