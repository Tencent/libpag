<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: TextBox anchor.y moves the pivot of a statically rotated text block along the vertical axis.
     Target: TextBox  Channel: anchor.y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <TextBox id="boxAnchorY" position="40,50" width="220" height="90" textAlign="center" paragraphAlign="middle" rotation="20">
      <Text text="AB" fontFamily="Arial" fontSize="36"/>
      <Fill color="#7C3AED"/>
    </TextBox>
  </Layer>
  <Animations>
    <Animation id="boxPivotY" duration="60" frameRate="60" loop="once">
      <Object target="boxAnchorY">
        <Channel name="anchor.y" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="70"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
