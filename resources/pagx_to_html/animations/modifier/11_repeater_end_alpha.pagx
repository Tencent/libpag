<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Repeater endAlpha fades the last copy out, so the row thins towards its tail.
     Target: Repeater  Channel: endAlpha  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="70,100" size="56,56" roundness="10"/>
    <Fill color="#9333EA"/>
    <Repeater id="rep" copies="4" offset="0" anchor="0,0" position="56,0"
              rotation="0" scale="1,1" startAlpha="1" endAlpha="1"/>
  </Layer>
  <Animations>
    <Animation id="repAnim" duration="60" frameRate="60" loop="once">
      <Object target="rep">
        <Channel name="endAlpha" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="0.1"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
