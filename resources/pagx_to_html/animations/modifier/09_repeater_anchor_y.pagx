<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A Repeater anchor.y moves the per-copy rotation pivot vertically, tilting the arc the other way.
     Target: Repeater  Channel: anchor.y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="70,100" size="56,56" roundness="10"/>
    <Fill color="#9333EA"/>
    <Repeater id="rep" copies="4" offset="0" anchor="0,0" position="56,0"
              rotation="18" scale="1,1" startAlpha="1" endAlpha="1"/>
  </Layer>
  <Animations>
    <Animation id="repAnim" duration="60" frameRate="60" loop="once">
      <Object target="rep">
        <Channel name="anchor.y" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="28"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
