<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Repeater copies grows the row from a single square to five evenly stepped squares.
     Target: Repeater  Channel: copies  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="40,100" size="60,60" roundness="10"/>
    <Fill color="#9333EA"/>
    <Repeater id="copyCount" copies="1" offset="0" anchor="0,0" position="60,0" scale="1,1" startAlpha="1" endAlpha="1"/>
  </Layer>
  <Animations>
    <Animation id="copyGrow" duration="60" frameRate="60" loop="once">
      <Object target="copyCount">
        <Channel name="copies" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="5"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
