<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A coverage mask contains Group -> Path + Fill; point animation must follow the same nested element tree as static masking.
     Target: Composite  Channel: point1.x,point2.x  Type: float
     Ref: R25 -->
<pagx width="320" height="200">
  <Layer width="320" height="200">
    <Rectangle position="160,100" size="320,200"/><Fill color="#F8FAFC"/>
    <Layer id="groupMask" width="320" height="200" visible="false" includeInLayout="false">
      <Group>
        <Path id="groupMaskPath" data="M 40 20 L 280 20 L 280 180 L 40 180 Z"/>
        <Fill><LinearGradient startPoint="0.5,0.5" endPoint="1,0.5">
          <ColorStop offset="0" color="#FFFFFFFF"/><ColorStop offset="1" color="#FFFFFF00"/>
        </LinearGradient></Fill>
      </Group>
    </Layer>
    <Layer mask="@groupMask" maskType="alpha" width="320" height="200">
      <Rectangle position="130,100" size="180,160"/><Fill color="#BE123C"/>
      <Ellipse position="220,100" size="140,140"/><Fill color="#1D4ED8"/>
    </Layer>
  </Layer>
  <Animations><Animation id="groupMaskWarp" duration="60" frameRate="60" loop="once">
    <Object target="groupMaskPath">
      <Channel name="point1.x" type="float"><Key time="0" value="280" interpolation="linear"/><Key time="60" value="100"/></Channel>
      <Channel name="point2.x" type="float"><Key time="0" value="280" interpolation="linear"/><Key time="60" value="160"/></Channel>
    </Object>
  </Animation></Animations>
</pagx>
