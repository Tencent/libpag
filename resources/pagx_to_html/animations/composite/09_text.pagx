<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: The two halves of the text pipeline on one Text node - a whole-text channel (fontSize,
     which needs the line re-laid out) and per-glyph channels (the selector's window and the
     modifier's colour, which need the baked glyph positions). The exporter currently routes such a
     Text down the glyph path, so the whole-text half is dropped: this case is expected to fail until
     the glyph path can reflow (see the span/glyph split in the README).
     Target: Composite  Channel: fontSize,fillColor,start,end  Type: mixed
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text id="mixedBody" text="MIXED" fontFamily="Arial" fontStyle="Bold" fontSize="34"
          letterSpacing="0" position="40,110"/>
    <TextModifier id="mixedMod" position="0,-12" fillColor="#9333EA">
      <RangeSelector id="mixedSel" start="0" end="1" offset="0" unit="percentage" shape="rampUp"/>
    </TextModifier>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="mixedText" duration="60" frameRate="60" loop="once">
      <Object target="mixedBody">
        <Channel name="fontSize" type="float">
          <Key time="0" value="34" interpolation="linear"/>
          <Key time="60" value="46"/>
        </Channel>
      </Object>
      <Object target="mixedSel">
        <Channel name="start" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="0.3"/>
        </Channel>
        <Channel name="end" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="60" value="0.85"/>
        </Channel>
      </Object>
      <Object target="mixedMod">
        <Channel name="fillColor" type="color">
          <Key time="0" value="#9333EA" interpolation="linear"/>
          <Key time="60" value="#0891B2"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
