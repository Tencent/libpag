<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Layer alpha reaches overlapping paints inside a retained transformed text Group, not only direct DOM children.
     Target: Composite  Channel: alpha  Type: float
     Ref: R16 -->
<pagx width="320" height="220">
  <Layer width="320" height="220"><Rectangle position="160,110" size="320,220"/><Fill color="#F8FAFC"/></Layer>
  <Layer id="wrappedFade" width="320" height="220" groupOpacity="false">
    <Group position="10,0">
      <Text text="OO" position="60,150" fontFamily="Arial" fontStyle="Regular" fontSize="100"/><Fill color="#BE123C"/>
      <Text text="OO" position="90,150" fontFamily="Arial" fontStyle="Regular" fontSize="100"/><Fill color="#1D4ED8"/>
    </Group>
  </Layer>
  <Animations><Animation id="wrappedAlpha" duration="60" frameRate="60" loop="once"><Object target="wrappedFade">
    <Channel name="alpha" type="float"><Key time="0" value="1" interpolation="linear"/><Key time="60" value="0.45"/></Channel>
  </Object></Animation></Animations>
</pagx>
