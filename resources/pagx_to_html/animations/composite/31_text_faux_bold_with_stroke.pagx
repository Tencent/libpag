<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Ordinary and modifier text keep synthetic emboldening separate from the real Stroke across several font sizes.
     Target: Composite  Channel: fauxBold,width  Type: mixed
     Ref: R3,R20 -->
<pagx width="480" height="240">
  <Layer width="480" height="240"><Rectangle position="240,120" size="480,240"/><Fill color="#F8FAFC"/></Layer>
  <Layer width="480" height="240">
    <Text id="boldSmall" text="EDGE" position="20,35" fontFamily="Arial" fontStyle="Regular" fontSize="9"/>
    <Fill color="#1D4ED8"/><Stroke id="smallOutline" color="#BE123C" width="1"/>
  </Layer>
  <Layer width="480" height="240">
    <Text id="boldMedium" text="EDGE" position="20,85" fontFamily="Arial" fontStyle="Regular" fontSize="24"/>
    <Fill color="#1D4ED8"/><Stroke id="mediumOutline" color="#BE123C" width="2"/>
  </Layer>
  <Layer width="480" height="240">
    <Text id="boldLarge" text="EDGE" position="20,175" fontFamily="Arial" fontStyle="Regular" fontSize="64"/>
    <Fill color="#1D4ED8"/><Stroke id="largeOutline" color="#BE123C" width="4"/>
  </Layer>
  <Layer width="480" height="240">
    <Text id="boldModifier" text="EDGE" position="270,135" fontFamily="Arial" fontStyle="Regular" fontSize="40"/>
    <TextModifier fillColor="#1D4ED8"><RangeSelector start="0" end="1" weight="1" shape="square"/></TextModifier>
    <Fill color="#1D4ED8"/><Stroke id="modifierOutline" color="#BE123C" width="3"/>
  </Layer>
  <Animations><Animation id="emboldenAndOutline" duration="60" frameRate="60" loop="once">
    <Object target="boldSmall"><Channel name="fauxBold" type="bool"><Key time="0" value="false" interpolation="hold"/><Key time="30" value="true" interpolation="hold"/><Key time="60" value="false"/></Channel></Object>
    <Object target="boldMedium"><Channel name="fauxBold" type="bool"><Key time="0" value="false" interpolation="hold"/><Key time="30" value="true" interpolation="hold"/><Key time="60" value="false"/></Channel></Object>
    <Object target="boldLarge"><Channel name="fauxBold" type="bool"><Key time="0" value="false" interpolation="hold"/><Key time="30" value="true" interpolation="hold"/><Key time="60" value="false"/></Channel></Object>
    <Object target="boldModifier"><Channel name="fauxBold" type="bool"><Key time="0" value="false" interpolation="hold"/><Key time="30" value="true" interpolation="hold"/><Key time="60" value="false"/></Channel></Object>
    <Object target="smallOutline"><Channel name="width" type="float"><Key time="0" value="1" interpolation="linear"/><Key time="60" value="2"/></Channel></Object>
    <Object target="mediumOutline"><Channel name="width" type="float"><Key time="0" value="2" interpolation="linear"/><Key time="60" value="4"/></Channel></Object>
    <Object target="largeOutline"><Channel name="width" type="float"><Key time="0" value="4" interpolation="linear"/><Key time="60" value="8"/></Channel></Object>
    <Object target="modifierOutline"><Channel name="width" type="float"><Key time="0" value="3" interpolation="linear"/><Key time="60" value="6"/></Channel></Object>
  </Animation></Animations>
</pagx>
