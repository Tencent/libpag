<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A paused instance's child-paint alpha remains paused while an independent visible clock moves.
     Target: Composite  Channel: alpha,x  Type: float
     Ref: R16 -->
<pagx width="320" height="220">
  <Resources><Composition id="pausedCard" width="220" height="140">
    <Layer id="pausedFade" width="220" height="140" groupOpacity="false">
      <Rectangle position="90,70" size="110,110"/><Fill color="#BE123C"/>
      <Rectangle position="140,70" size="110,110"/><Fill color="#1D4ED8"/>
    </Layer>
    <Animations><Animation id="pausedAlpha" duration="60" frameRate="60" loop="once"><Object target="pausedFade">
      <Channel name="alpha" type="float"><Key time="0" value="1" interpolation="linear"/><Key time="60" value="0.45"/></Channel>
    </Object></Animation></Animations>
  </Composition></Resources>
  <Layer width="320" height="220"><Rectangle position="160,110" size="320,220"/><Fill color="#F8FAFC"/></Layer>
  <Layer x="40" y="30" width="220" height="140" composition="@pausedCard"><Timelines><Animation ref="@pausedAlpha" playing="false"/></Timelines></Layer>
  <Layer y="185" width="320" height="20">
    <Layer id="visibleClock" width="20" height="12"><Rectangle position="10,6" size="20,12"/><Fill color="#0F172A"/></Layer>
  </Layer>
  <Animations><Animation id="clockMove" duration="60" frameRate="60" loop="once"><Object target="visibleClock">
    <Channel name="x" type="float"><Key time="0" value="30" interpolation="linear"/><Key time="60" value="270"/></Channel>
  </Object></Animation></Animations>
</pagx>
