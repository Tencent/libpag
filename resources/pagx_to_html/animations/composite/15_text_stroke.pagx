<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: A TextModifier strokes its glyphs and the stroke re-colours while the same modifier
     rotates them: two modifier channels plus a pose channel on one timeline.
     Target: TextModifier  Channel: strokeColor,strokeWidth,rotation  Type: mixed
     Expect: supported
     Ref: PAGXHtmlTest.AnimationTextModifierStroke -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="STROKE" fontFamily="Arial" fontStyle="Bold" fontSize="48" position="60,120"/>
    <TextModifier id="strokeMod" position="0,-10" strokeColor="#0E7490" strokeWidth="1.5"
                  anchor="0.5,0.5">
      <RangeSelector id="strokeSel" start="0" end="1" offset="0" unit="percentage" shape="rampUp"
                     easeIn="0" easeOut="0" weight="1"/>
    </TextModifier>
    <Fill color="#BE123C"/>
  </Layer>
  <Animations>
    <Animation id="strokeMix" duration="60" frameRate="60" loop="once">
      <Object target="strokeMod">
        <Channel name="strokeColor" type="color">
          <Key time="0" value="#0E7490" interpolation="linear"/>
          <Key time="60" value="#B45309"/>
        </Channel>
        <Channel name="strokeWidth" type="float">
          <Key time="0" value="1.5" interpolation="linear"/>
          <Key time="60" value="3"/>
        </Channel>
        <Channel name="rotation" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="8"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
