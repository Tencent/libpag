<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: rotation.x tips the card around its bottom edge because anchor.y sits on that edge, so the card opens like
     a lid instead of shrinking around its centre.
     Target: Layer  Channel: rotation.x  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="cardLid" x="100" y="60" width="120" height="80" anchor="0,80" perspective="600">
    <Rectangle position="60,40" size="120,80" roundness="12"/>
    <Fill color="#C2410C"/>
    <Group position="24,24">
      <Rectangle position="36,16" size="72,32" roundness="8"/>
      <Fill color="#FED7AA"/>
    </Group>
  </Layer>
  <Animations>
    <Animation id="cardLidOpen" duration="60" frameRate="60" loop="loop">
      <Object target="cardLid">
        <Channel name="rotation.x" type="float">
          <Key time="0" value="-40" interpolation="linear"/>
          <Key time="30" value="40" interpolation="linear"/>
          <Key time="60" value="-40"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
