<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: An animated anchor.y slides the pivot from the top edge of the card to its vertical middle
     while the card keeps a static 15 degree rotation, so the same pose is re-pivoted every frame.
     Target: Layer  Channel: anchor.y  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="cardPivotY" x="120" y="70" width="100" height="60" anchor="50,0" rotationZ="15">
    <Rectangle position="50,30" size="100,60" roundness="10"/>
    <Fill color="#0E7490"/>
  </Layer>
  <Animations>
    <Animation id="pivotSlideY" duration="60" frameRate="60" loop="once">
      <Object target="cardPivotY">
        <Channel name="anchor.y" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="60"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
