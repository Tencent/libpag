<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Group skewAxis rotates the shear direction while the skew angle stays fixed.
     Target: Group  Channel: skewAxis  Type: float
     Expect: gap
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Group id="skewAxisGroup" position="120,40" skew="30" skewAxis="0">
      <Rectangle size="80,80" roundness="8"/>
      <Fill color="#2563EB"/>
    </Group>
  </Layer>
  <Animations>
    <Animation id="groupSkewAxis" duration="60" frameRate="60" loop="once">
      <Object target="skewAxisGroup">
        <Channel name="skewAxis" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="90" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
