<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Group rotation spins around a non-zero static anchor so the contents turn in place.
     Target: Group  Channel: rotation  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Group id="anchorSpinGroup" position="160,100" anchor="40,40" rotation="0">
      <Rectangle size="80,80" roundness="8"/>
      <Fill color="#2563EB"/>
    </Group>
  </Layer>
  <Animations>
    <Animation id="groupAnchorSpin" duration="60" frameRate="60" loop="once">
      <Object target="anchorSpinGroup">
        <Channel name="rotation" type="float">
          <Key time="0" value="0" interpolation="linear"/>
          <Key time="60" value="90" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
