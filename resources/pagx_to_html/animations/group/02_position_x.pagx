<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: Group position.x slides the group contents to the right.
     Target: Group  Channel: position.x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Group id="moveGroupX" position="60,60">
      <Rectangle size="80,80" roundness="8"/>
      <Fill color="#2563EB"/>
    </Group>
  </Layer>
  <Animations>
    <Animation id="groupSlideX" duration="60" frameRate="60" loop="once">
      <Object target="moveGroupX">
        <Channel name="position.x" type="float">
          <Key time="0" value="60" interpolation="linear"/>
          <Key time="60" value="200" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
