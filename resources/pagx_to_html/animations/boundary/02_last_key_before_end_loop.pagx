<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: when the last key sits 30 frames before the end of a looping animation the value holds
     from that key to the end of every cycle.
     Target: Layer  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="earlyEndBox" x="120" y="60" width="80" height="80">
    <Rectangle position="40,40" size="80,80" roundness="8"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="earlyEndFade" duration="120" frameRate="60" loop="loop">
      <Object target="earlyEndBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="0.2" interpolation="linear"/>
          <Key time="90" value="1" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
