<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a key placed past the duration still leaves the channel reachable but the ramp stops
     early at the duration boundary.
     Target: Layer  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="overKeyBox" x="120" y="60" width="80" height="80">
    <Rectangle position="40,40" size="80,80" roundness="8"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="overKeyFade" duration="120" frameRate="60" loop="once">
      <Object target="overKeyBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="0.2" interpolation="linear"/>
          <Key time="180" value="1" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
