<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: keys that do not cover [0, duration] hold their first and last values outside the key
     range, and a Once animation with evaluationOffset shows the first key value during the delay, so
     the exported keyframes need explicit 0% and 100% stops instead of interpolating from the
     element's static style.
     Target: Layer  Channel: alpha,x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="400" height="160">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="onceBox" left="20" top="20" width="40" height="40">
    <Rectangle width="40" height="40"/>
    <Fill color="#14B8A6"/>
    <Timelines>
      <Animation ref="@onceAnim" evaluationOffset="30"/>
    </Timelines>
  </Layer>
  <Layer id="slider" left="20" top="100" width="40" height="40">
    <Rectangle width="40" height="40"/>
    <Fill color="#0F766E"/>
  </Layer>
  <Animations>
    <Animation id="onceAnim" duration="120" frameRate="60" loop="once">
      <Object target="onceBox">
        <Channel name="alpha" type="float">
          <Key time="30" value="0.2" interpolation="linear"/>
          <Key time="120" value="1"/>
        </Channel>
      </Object>
    </Animation>
    <Animation id="slideAnim" duration="120" frameRate="60" loop="loop">
      <Object target="slider">
        <Channel name="x" type="float">
          <Key time="30" value="100" interpolation="linear"/>
          <Key time="90" value="300"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
