<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a channel with a single key holds that value for the whole duration, so this case only
     smoke tests that a single key still exports instead of feeding a per-frame pixel comparison.
     Target: Layer  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="singleKeyBox" x="120" y="60" width="80" height="80">
    <Rectangle position="40,40" size="80,80" roundness="8"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="singleKeyFade" duration="60" frameRate="60" loop="once">
      <Object target="singleKeyBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="0.4" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
