<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a looping channel whose last key sits past the duration still repeats every
     `duration` frames. The ramp only reaches the value interpolated at the duration boundary
     (1.0 -> 0.6667 here) before wrapping, so the CSS period must stay 60 frames instead of being
     stretched to reach the key at 90.
     Target: Layer  Channel: alpha  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="loopOverKeyBox" x="120" y="60" width="80" height="80">
    <Rectangle position="40,40" size="80,80" roundness="8"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Animations>
    <Animation id="loopOverKeyFade" duration="60" frameRate="60" loop="loop">
      <Object target="loopOverKeyBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="90" value="0" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
