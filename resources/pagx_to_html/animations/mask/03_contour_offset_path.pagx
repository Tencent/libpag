<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a Contour mask whose layer sits at a non-zero position. The clip must follow the mask
     layer's local transform, so the animated clip-path has to carry that offset instead of using
     the mask path's raw coordinates.
     The mask layer stays visible so players keep it in the animated subtree; it is consumed as a
     mask and therefore never painted on its own.
     Target: Path  Channel: point1.x,point2.x  Type: float
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Layer left="0" right="0" top="0" bottom="0">
    <Layer id="offsetMask" left="120" top="40">
      <Path id="offsetPath" data="M 0 0 L 200 0 L 200 200 L 0 200 Z"/>
      <Fill color="#FFFFFF"/>
    </Layer>
    <Layer id="maskedBox" mask="@offsetMask" maskType="contour">
      <Rectangle position="160,100" size="300,180"/>
      <Fill color="#2563EB"/>
    </Layer>
  </Layer>
  <Animations>
    <Animation id="growClip" duration="60" frameRate="60" loop="loop">
      <Object target="offsetPath">
        <Channel name="point1.x" type="float">
          <Key time="0" value="200" interpolation="linear"/>
          <Key time="60" value="40"/>
        </Channel>
        <Channel name="point2.x" type="float">
          <Key time="0" value="200" interpolation="linear"/>
          <Key time="60" value="40"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
