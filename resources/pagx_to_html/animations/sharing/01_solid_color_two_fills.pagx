<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: one animated SolidColor resource backs two Fills in separate layers so both shapes must
     change color together, and this case currently passes for the wrong reason because the runtime
     binds the shared color source to only the last Fill and the export drops the same one.
     Target: SolidColor  Channel: color  Type: color
     Expect: supported
     Ref: - -->
<pagx width="320" height="200">
  <Resources>
    <SolidColor id="sharedColor" color="#2563EB"/>
  </Resources>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="80,100" size="100,100" roundness="8"/>
    <Fill color="@sharedColor"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle position="240,100" size="100,100" roundness="8"/>
    <Fill color="@sharedColor"/>
  </Layer>
  <Animations>
    <Animation id="sharedColorShift" duration="60" frameRate="60" loop="once">
      <Object target="sharedColor">
        <Channel name="color" type="color">
          <Key time="0" value="#2563EB" interpolation="linear"/>
          <Key time="60" value="#F97316" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
