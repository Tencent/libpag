<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: a document that carries an embedded vector font (so the export has to emit @font-face)
     while text and shapes animate. The animation CSS and the font rules are different outputs and
     must be emitted independently: tying the keyframes to the font rules means any change in font
     emission can silently drop the animation.
     The text uses a system font so the preview stays readable; the embedded font only exists to
     make the exporter produce @font-face rules.
     This lives in unit/ rather than animations/ on purpose: the coupling it guards is structural
     and produces no visual difference, while every animations/ case is expected to show a visible
     gap between the exported HTML and the PAGX render.
     Target: Layer / Fill  Channel: alpha / color  Type: float / color
     Expect: supported
     Ref: - -->
<pagx width="240" height="120">
  <Resources>
    <Font id="shapes" unitsPerEm="1000">
      <Glyph advance="700" path="M 0,0 L 700,0 L 700,-700 L 0,-700 Z"/>
    </Font>
  </Resources>
  <Layer left="0" right="0" top="0" bottom="0">
    <Rectangle left="0" right="0" top="0" bottom="0"/>
    <Fill color="#F8FAFC"/>
  </Layer>
  <Layer id="fadeBox" width="240" height="120">
    <Rectangle position="60,60" size="80,80" roundness="12"/>
    <Fill color="#2563EB"/>
  </Layer>
  <Layer left="0" right="0" top="0" bottom="0">
    <Text text="AB" fontFamily="Arial" fontSize="40" position="170,60"/>
    <Fill id="textFill" color="#1D4ED8"/>
  </Layer>
  <Animations>
    <Animation id="mixedAnim" duration="60" frameRate="60" loop="loop">
      <Object target="fadeBox">
        <Channel name="alpha" type="float">
          <Key time="0" value="1" interpolation="linear"/>
          <Key time="30" value="0.2" interpolation="linear"/>
          <Key time="60" value="1"/>
        </Channel>
      </Object>
      <Object target="textFill">
        <Channel name="color" type="color">
          <Key time="0" value="#1D4ED8" interpolation="linear"/>
          <Key time="30" value="#F97316" interpolation="linear"/>
          <Key time="60" value="#1D4ED8"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
</pagx>
