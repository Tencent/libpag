<?xml version="1.0" encoding="UTF-8"?>
<!-- Keyframed image scale (design doc 12.2): the image shows at ~0.37x statically (24px box
     over a 96px image), but a matrix animation doubles the layer transform, so the real max
     display scale is ~0.8 — the image must NOT be downscaled below what the animation needs. -->
<pagx width="200" height="200">
  <Layer id="zoomBox" centerX="0" centerY="0" width="24" height="24">
    <Rectangle width="24" height="24" roundness="4"/>
    <Fill>
      <ImagePattern image="@inline" scaleMode="letterBox"/>
    </Fill>
  </Layer>
  <Animations>
    <Animation id="zoom" duration="60" frameRate="60">
      <Object target="zoomBox">
        <Channel name="matrix" type="matrix">
          <Key time="0" value="1,0,0,1,0,0" interpolation="linear"/>
          <Key time="60" value="2,0,0,2,0,0" interpolation="linear"/>
        </Channel>
      </Object>
    </Animation>
  </Animations>
  <Resources>
    <Image id="inline" source="data:image/png;base64,"/>
  </Resources>
</pagx>
