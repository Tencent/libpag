<?xml version="1.0" encoding="UTF-8"?>
<!-- A Text smaller than its natural width is uniformly scaled by layout; the
     flatten step bakes the fit scale back into the Text's own size fields. -->
<pagx width="400" height="200">
  <Layer left="40" top="80" width="160" height="36">
    <Text id="longTitle" text="Layout Scaled Text Sample" fontFamily="Arial"
          fontSize="24" width="160"/>
    <Fill color="#1E293B"/>
  </Layer>
  <Layer left="40" top="140" width="160" height="20">
    <Rectangle width="160" height="1"/>
    <Fill color="#CBD5E1"/>
  </Layer>
</pagx>
