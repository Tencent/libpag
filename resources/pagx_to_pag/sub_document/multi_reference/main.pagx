<?xml version="1.0" encoding="UTF-8"?>
<!-- Same external file referenced by two layers: packed once, decoded per
     reference so instances stay independent. -->
<pagx width="400" height="200">
  <Layer left="80" top="60" width="80" height="80" composition="badge.pagx"/>
  <Layer left="240" top="60" width="80" height="80" composition="badge.pagx"/>
</pagx>
