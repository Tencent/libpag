<?xml version="1.0" encoding="UTF-8"?>
<!-- All four DataBind directions: ToTarget (default), ToSource, TwoWay, Once. -->
<pagx width="400" height="300" viewModel="@dirVM">
  <Resources>
    <ViewModel id="dirVM">
      <Property name="alphaA" type="number" default="1" min="0" max="1"/>
      <Property name="alphaB" type="number" default="0.5" min="0" max="1"/>
      <Property name="alphaC" type="number" default="0.8" min="0" max="1"/>
      <Property name="alphaD" type="number" default="0.3" min="0" max="1"/>
    </ViewModel>
  </Resources>

  <Layer id="cellA" left="40" top="40" width="60" height="60">
    <Rectangle width="60" height="60" roundness="8"/><Fill color="#0EA5E9"/>
  </Layer>
  <Layer id="cellB" left="120" top="40" width="60" height="60">
    <Rectangle width="60" height="60" roundness="8"/><Fill color="#10B981"/>
  </Layer>
  <Layer id="cellC" left="200" top="40" width="60" height="60">
    <Rectangle width="60" height="60" roundness="8"/><Fill color="#F59E0B"/>
  </Layer>
  <Layer id="cellD" left="280" top="40" width="60" height="60">
    <Rectangle width="60" height="60" roundness="8"/><Fill color="#EF4444"/>
  </Layer>

  <DataBind source="$vm.alphaA" target="@cellA" channel="alpha" direction="ToTarget"/>
  <DataBind source="$vm.alphaB" target="@cellB" channel="alpha" direction="ToSource"/>
  <DataBind source="$vm.alphaC" target="@cellC" channel="alpha" direction="TwoWay"/>
  <DataBind source="$vm.alphaD" target="@cellD" channel="alpha" direction="Once"/>
</pagx>
