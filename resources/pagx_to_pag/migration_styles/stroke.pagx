<?xml version="1.0" encoding="UTF-8"?>
<pagx width="720" height="1280" viewModel="@pag-editable-vm">
  <Layer width="720" height="1280" composition="@pag-legacy-comp-2"/>
  <Animations>
    <Animation id="pag-legacy-root" duration="4500" frameRate="30" loop="once">
    </Animation>
  </Animations>
  <Resources>
    <Composition id="pag-legacy-comp-2" width="720" height="1280">
      <Layer id="pag-legacy-9" x="360" y="640" width="720" height="1280" anchor="360,640">
        <Rectangle position="360,640" size="720,1280"/>
        <Fill color="@pag-editable-image-0"/>
      </Layer>
      <Layer id="pag-legacy-7" x="358" y="572">
        <TextBox>
          <Text id="pag-editable-text-0" text="内描边" fontFamily="PingFang SC" fontStyle="Regular" fontSize="120" fauxBold="true"/>
          <Fill color="#FFFFFF"/>
        </TextBox>
        <StrokeLayerStyle id="pag-legacy-stroke-8" color="#FFD300" size="5" position="inside"/>
      </Layer>
      <Layer id="pag-legacy-5" x="350" y="418">
        <TextBox>
          <Text id="pag-editable-text-1" text="中心描边" fontFamily="PingFang SC" fontStyle="Regular" fontSize="120" fauxBold="true"/>
          <Fill color="#FFFFFF"/>
        </TextBox>
        <StrokeLayerStyle id="pag-legacy-stroke-6" color="#FFD300" size="5" position="center"/>
      </Layer>
      <Layer id="pag-legacy-3" x="358" y="272">
        <TextBox>
          <Text id="pag-editable-text-2" text="外描边" fontFamily="PingFang SC" fontStyle="Regular" fontSize="120" fauxBold="true"/>
          <Fill color="#FFFFFF"/>
        </TextBox>
        <StrokeLayerStyle id="pag-legacy-stroke-4" color="#FFD300" size="5"/>
      </Layer>
      <Animations>
        <Animation id="pag-legacy-anim-2" duration="150" frameRate="30" loop="once">
          <Object target="pag-legacy-9">
            <Channel name="visible" type="bool">
              <Key time="0" value="true" interpolation="hold"/>
              <Key time="150" value="false" interpolation="hold"/>
            </Channel>
          </Object>
          <Object target="pag-legacy-7">
            <Channel name="visible" type="bool">
              <Key time="0" value="true" interpolation="hold"/>
              <Key time="150" value="false" interpolation="hold"/>
            </Channel>
          </Object>
          <Object target="pag-legacy-5">
            <Channel name="visible" type="bool">
              <Key time="0" value="true" interpolation="hold"/>
              <Key time="150" value="false" interpolation="hold"/>
            </Channel>
          </Object>
          <Object target="pag-legacy-3">
            <Channel name="visible" type="bool">
              <Key time="0" value="true" interpolation="hold"/>
              <Key time="150" value="false" interpolation="hold"/>
            </Channel>
          </Object>
        </Animation>
      </Animations>
      <DataBind source="$vm.text0" target="@pag-editable-text-2" channel="text"/>
      <DataBind source="$vm.text1" target="@pag-editable-text-1" channel="text"/>
      <DataBind source="$vm.text2" target="@pag-editable-text-0" channel="text"/>
      <DataBind source="$vm.image0" target="@pag-editable-image-0" channel="image"/>
    </Composition>
    <ImagePattern id="pag-editable-image-0" image="data:image/webp;base64," scaleMode="stretch"/>
    <ViewModel id="pag-editable-vm">
      <Property name="text0" type="String" default="外描边"/>
      <Property name="text1" type="String" default="中心描边"/>
      <Property name="text2" type="String" default="内描边"/>
      <Property name="image0" type="Image" default="@"/>
    </ViewModel>
  </Resources>
</pagx>
