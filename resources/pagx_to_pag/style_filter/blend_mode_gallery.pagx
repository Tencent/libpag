<?xml version="1.0" encoding="UTF-8"?>
<!-- Layer and painter blend modes: multiply, screen, overlay, plusLighter. -->
<pagx width="400" height="300">
  <Layer left="20" top="20" width="360" height="90">
    <Rectangle width="360" height="90"/>
    <Fill>
      <LinearGradient endPoint="1,0">
        <ColorStop color="#FFFFFF" offset="0"/>
        <ColorStop color="#111827" offset="1"/>
      </LinearGradient>
    </Fill>
  </Layer>
  <Layer left="40" top="40" width="70" height="50" blendMode="multiply">
    <Rectangle width="70" height="50"/><Fill color="#F59E0B"/>
  </Layer>
  <Layer left="130" top="40" width="70" height="50" blendMode="screen">
    <Rectangle width="70" height="50"/><Fill color="#F59E0B"/>
  </Layer>
  <Layer left="220" top="40" width="70" height="50" blendMode="overlay">
    <Rectangle width="70" height="50"/><Fill color="#F59E0B"/>
  </Layer>
  <Layer left="310" top="40" width="70" height="50" blendMode="plusLighter">
    <Rectangle width="70" height="50"/><Fill color="#F59E0B"/>
  </Layer>
  <Layer left="130" top="160" width="140" height="80">
    <Rectangle width="140" height="80" roundness="10"/>
    <Fill color="#1E293B"/>
    <Fill color="#38BDF8" blendMode="screen"/>
  </Layer>
</pagx>
