<?xml version="1.0" encoding="UTF-8"?>
<!-- Bitmap glyph shapes (Emoji-style): Glyph entries reference PNG images instead
     of vector paths; bytes are stored verbatim in the binary ImageTable. -->
<pagx width="400" height="200">
  <Layer centerX="0" centerY="0">
    <Text id="icons" text="AB" fontFamily="Icons" fontSize="64">
      <GlyphRun font="@iconFont" fontSize="64" glyphs="1,2" x="136" y="118" bounds="0,0,128,128"/>
    </Text>
    <Fill color="#334155"/>
  </Layer>
  <Resources>
    <Font id="iconFont" unitsPerEm="100">
      <Glyph advance="64" image="data:image/png;base64," offset="0,-4"/>
      <Glyph advance="64" image="data:image/png;base64,"/>
    </Font>
  </Resources>
</pagx>
