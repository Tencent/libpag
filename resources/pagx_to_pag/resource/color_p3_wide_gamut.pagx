<?xml version="1.0" encoding="UTF-8"?>
<!-- Display P3 wide-gamut colors in p3(r,g,b) / p3(r,g,b,a) form; the binary
     stores these as float32 + color space instead of 8-bit sRGB. -->
<pagx width="400" height="240">
  <Layer left="40" top="40" width="90" height="90">
    <Rectangle width="90" height="90" roundness="8"/>
    <Fill color="p3(1.0, 0.0, 0.5)"/>
  </Layer>
  <Layer left="155" top="40" width="90" height="90">
    <Rectangle width="90" height="90" roundness="8"/>
    <Fill color="p3(0.0, 1.0, 0.3)"/>
  </Layer>
  <Layer left="270" top="40" width="90" height="90">
    <Rectangle width="90" height="90" roundness="8"/>
    <Fill color="p3(0.2, 0.1, 1.0, 0.6)"/>
  </Layer>
  <Layer left="40" top="150" width="320" height="40">
    <Rectangle width="320" height="40"/>
    <Fill>
      <LinearGradient endPoint="1,0">
        <ColorStop offset="0" color="p3(1.0, 0.0, 0.5)"/>
        <ColorStop offset="1" color="p3(0.0, 1.0, 0.3)"/>
      </LinearGradient>
    </Fill>
  </Layer>
</pagx>
