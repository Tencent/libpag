<?xml version="1.0" encoding="UTF-8"?>
<!-- One external image referenced by two patterns: the exporter loads it once,
     deduplicates the bytes, and keeps a single ImageTable entry. -->
<pagx width="400" height="240">
  <Layer left="40" top="40" width="120" height="120">
    <Rectangle width="120" height="120" roundness="12"/>
    <Fill>
      <ImagePattern image="@sharedLogo" scaleMode="letterBox"/>
    </Fill>
  </Layer>
  <Layer left="200" top="80" width="160" height="80">
    <Ellipse width="160" height="80"/>
    <Fill>
      <ImagePattern image="@sharedLogo" scaleMode="stretch"/>
    </Fill>
  </Layer>
  <Resources>
    <Image id="sharedLogo" source="pag_logo.png"/>
  </Resources>
</pagx>
