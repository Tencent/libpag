<?xml version="1.0" encoding="UTF-8"?>
<!-- Inline base64 data URI image: bytes are embedded in the binary at export. -->
<pagx width="400" height="200">
  <Layer centerX="0" centerY="0" width="96" height="96">
    <Rectangle width="96" height="96" roundness="16"/>
    <Fill>
      <ImagePattern image="@inline" scaleMode="letterBox"/>
    </Fill>
  </Layer>
  <Resources>
    <Image id="inline" source="data:image/png;base64,"/>
  </Resources>
</pagx>
